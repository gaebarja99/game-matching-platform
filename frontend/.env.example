# GameMatcher API 서버 (Spring Boot). 분리형 아키텍처 시 백엔드 주소.
VITE_API_URL=http://localhost:8080

# Firebase (휴대폰 인증: 회원가입, 아이디/비밀번호 찾기).
# 필수: Authentication → Sign-in method에서 Phone 활성화.
# 필수: Authentication → Settings → Authorized domains에 localhost 추가.
# "Failed to initialize reCAPTCHA enterprise verification" / "reCAPTCHA Timeout" 발생 시:
#   Google Cloud Console → reCAPTCHA Enterprise → 해당 키에 localhost 도메인 추가,
#   또는 Identity Platform에서 reCAPTCHA Enterprise 비활성화 후 일반 reCAPTCHA 사용.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=   # 선택 (Analytics 사용 시)
#
# 로컬 전용: Firebase 미설정 시에도 localhost에서 전화 인증 UI를 모의로 통과 (고정 인증번호).
# 배포(스테이징/운영)에서는 반드시 위 VITE_FIREBASE_* 를 설정하고 실제 SMS를 사용하세요.
# VITE_PHONE_AUTH_DEV_FALLBACK=true
# VITE_PHONE_AUTH_DEV_CODE=123456
#
# reCAPTCHA Enterprise (전화 인증 시 "enterprise verification" 오류 시 사용)
# Google reCAPTCHA Enterprise 키의 사이트 키. 설정 시 앱 부팅 시 enterprise.js 미리 로드.
# VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# VITE_FIREBASE_VAPID_KEY=        # Cloud Messaging > Web Push certificates 공개키
