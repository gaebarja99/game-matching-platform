/** Team Searching Í≤Ä??Ï°∞Í±¥??Í≤åÏûÑÎ≥?Î™®Îìú/??Å¨ ?µÏÖò (Ï≤??µÏÖò '?ÑÏ≤¥') */
function getSearchModeOptions(game: string): { value: string; label: string }[] {
  switch (game) {
    case 'LEAGUE_OF_LEGENDS': return RANK_OPTIONS;
    case 'VALORANT': return VALORANT_MODE_OPTIONS;
    case 'OVERWATCH': return OVERWATCH_MODE_OPTIONS;
    case 'PUBG': return [{ value: '', label: '?ÑÏ≤¥' }, ...PUBG_MODE_OPTIONS.filter((o) => o.value).map((o) => ({ value: o.value, label: o.label }))];
    case 'APEX_LEGENDS': return APEX_MODE_OPTIONS;
    case 'COUNTER_STRIKE_2': return [{ value: '', label: '?ÑÏ≤¥' }];
    default: return RANK_OPTIONS;
  }
}

/** ?úÎç§ Îß§Ïπ≠??Í≤åÏûÑÎ≥?Î™®Îìú ?µÏÖò (Î∞?ÎßåÎì§Í∏∞Ï? ?ôÏùº, CS2 ?úÏô∏) */
function getMatchModeOptions(game: string): { value: string; label: string }[] {
  switch (game) {
    case 'LEAGUE_OF_LEGENDS': return RANK_OPTIONS;
    case 'VALORANT': return VALORANT_MODE_OPTIONS;
    case 'OVERWATCH': return OVERWATCH_MODE_OPTIONS;
    case 'PUBG': return PUBG_MODE_OPTIONS;
    case 'APEX_LEGENDS': return APEX_MODE_OPTIONS;
    default: return [];
  }
}

/** ?úÎç§ Îß§Ïπ≠??Í≤åÏûÑÎ≥??∏Ïõê ?µÏÖò (Î∞?ÎßåÎì§Í∏∞Ï? ?ôÏùº) */
function getMatchPartyOptions(game: string): { value: string; label: string }[] {
  switch (game) {
    case 'LEAGUE_OF_LEGENDS': return LEAGUE_PARTY_OPTIONS;
    case 'VALORANT': return VALORANT_PARTY_OPTIONS;
    case 'OVERWATCH': return OVERWATCH_PARTY_OPTIONS;
    case 'PUBG': return PUBG_PARTY_OPTIONS;
    case 'COUNTER_STRIKE_2': return CS2_PARTY_OPTIONS;
    case 'APEX_LEGENDS': return APEX_PARTY_OPTIONS;
    default: return [];
  }
}

type SidebarTab = 'random' | 'history' | 'create';

function parseGameOptions(s?: string | null): {
  tier?: string;
  mode?: string;
  position?: string;
  preferredMap?: string;
  preferredMethod?: string;
  preferredLegend?: string;
  platform?: string;
  partySize?: string;
} {
  if (!s || !s.trim()) return {};
  try {
    const o = JSON.parse(s) as Record<string, string>;
    return {
      tier: o.tier,
      mode: o.mode,
      position: o.position,
      preferredMap: o.preferredMap,
      preferredMethod: o.preferredMethod,
      preferredLegend: o.preferredLegend,
      platform: o.platform,
      partySize: o.partySize,
    };
  } catch {
    return {};
  }
}

export default function Home() {
  const { user, loading: authLoading } = useAuth();
  const [searchParams, setSearchParams] = useSearchParams();
  const navigate = useNavigate();
  const [game, setGame] = useState('LEAGUE_OF_LEGENDS');
  const [roomList, setRoomList] = useState<GameRoomItem[]>([]);
  const [loadingRooms, setLoadingRooms] = useState(false);
  const [filterTier, setFilterTier] = useState('');
  const [filterRank, setFilterRank] = useState('');
  const [filterPosition, setFilterPosition] = useState<string | null>(null);
  const [filterPlatform, setFilterPlatform] = useState('');
  const [filterPreferredMap, setFilterPreferredMap] = useState('');
  const [sidebarTab, setSidebarTab] = useState<SidebarTab>('create');
  /** ?∞Ï∏° ?úÎç§ Îß§Ïπ≠/?¥Ïó≠/Î∞©Îßå?§Í∏∞ ?®ÎÑê ?úÏãú ?¨Î? (Í∞ôÏ? Î≤ÑÌäº ?§Ïãú ?ÑÎ•¥Î©??´Ìûò) */
  const [showMatchingSidebar, setShowMatchingSidebar] = useState(false);
  const [matchInQueue, setMatchInQueue] = useState(false);
  const [matchJoining, setMatchJoining] = useState(false);
  const [matchGame, setMatchGame] = useState('LEAGUE_OF_LEGENDS');
  const [matchMode, setMatchMode] = useState('');
  const [matchTier, setMatchTier] = useState('');
  const [matchPartySize, setMatchPartySize] = useState('');
  const [matchPosition, setMatchPosition] = useState<string | null>(null);
  const [liveStreams, setLiveStreams] = useState<StreamItem[]>([]);
  const [loadingLive, setLoadingLive] = useState(false);
  const [matchHistoryList, setMatchHistoryList] = useState<MatchSessionListItem[]>([]);
  const [matchHistoryLoading, setMatchHistoryLoading] = useState(false);
  const [matchHistoryDeletingId, setMatchHistoryDeletingId] = useState<number | null>(null);

  // Î∞?ÎßåÎì§Í∏???  const [createGame, setCreateGame] = useState('LEAGUE_OF_LEGENDS');
  const [createTitle, setCreateTitle] = useState('');
  const [createTier, setCreateTier] = useState('');
  const [createRank, setCreateRank] = useState('SOLO');
  const [createPosition, setCreatePosition] = useState<string | null>(null);
  const [createMode, setCreateMode] = useState('');
  const [createPreferredMap, setCreatePreferredMap] = useState('');
  const [createPreferredMethod, setCreatePreferredMethod] = useState('');
  const [createPreferredLegend, setCreatePreferredLegend] = useState('');
  const [createPlatform, setCreatePlatform] = useState('');
  const [createPartySize, setCreatePartySize] = useState('');
  const [createPassword, setCreatePassword] = useState('');
  const [createMemo, setCreateMemo] = useState('');
  const [creating, setCreating] = useState(false);
  const [createError, setCreateError] = useState('');
  const [joinRoomId, setJoinRoomId] = useState<number | null>(null);

  const fetchRooms = useCallback(() => {
    setLoadingRooms(true);
    const gameParam = game === 'ALL' ? undefined : game;
    fetchGameRoomList(gameParam, false)
      .then((list) => {
        setRoomList(list);
      })
      .finally(() => setLoadingRooms(false));
  }, [game]);

  const handleJoinRoom = async (roomId: number) => {
    if (!user) {
      navigate('/login');
      return;
    }
    setJoinRoomId(roomId);
    const ok = await joinGameRoom(roomId);
    setJoinRoomId(null);
    if (ok) {
      const chatRoomId = await getGameRoomChatRoomId(roomId);
      if (chatRoomId != null) navigate(`/group-chat/room/${chatRoomId}`, { state: { fromGameRoom: true, gameRoomId: roomId } });
      fetchRooms();
    }
  };

  useEffect(() => {
    if (searchParams.get('oauth2_error') === 'not_configured') {
      setSearchParams({}, { replace: true });
      navigate('/login?error=oauth_not_configured', { replace: true });
    }
  }, [searchParams, setSearchParams, navigate]);

  useEffect(() => {
    if (authLoading) return;
    fetchRooms();
  }, [authLoading, fetchRooms]);

  const fetchMatchHistory = useCallback(() => {
    if (!user) return;
    setMatchHistoryLoading(true);
    getMyMatchSessions()
      .then(setMatchHistoryList)
      .finally(() => setMatchHistoryLoading(false));
  }, [user]);

  useEffect(() => {
    const open = sidebarTab === 'history';
    if (open && user) fetchMatchHistory();
  }, [sidebarTab, user, fetchMatchHistory]);

  const formatHistoryTime = (createdAt: string) => {
    try {
      return new Date(createdAt).toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', hour12: true });
    } catch {
      return '';
    }
  };

  const handleDeleteMatchHistory = async (sessionId: number) => {
    if (matchHistoryDeletingId != null) return;
    setMatchHistoryDeletingId(sessionId);
    const ok = await deleteMatchSession(sessionId);
    setMatchHistoryDeletingId(null);
    if (ok) setMatchHistoryList((prev) => prev.filter((s) => s.id !== sessionId));
  };

  const MATCH_HISTORY_GAME_LABELS: Record<string, string> = {
    LEAGUE_OF_LEGENDS: 'Î¶¨Í∑∏ ?§Î∏å ?àÏ†Ñ??,
    VALORANT: 'Î∞úÎ°ú?Ä??,
    OVERWATCH: '?§Î≤Ñ?åÏπò2',
    PUBG: 'PUBG',
    COUNTER_STRIKE_2: 'CS2',
    APEX_LEGENDS: '?êÏù¥?ôÏä§',
  };

  useEffect(() => {
    if (authLoading) return;
    setLoadingLive(true);
    fetchLiveStreams().then(setLiveStreams).finally(() => setLoadingLive(false));
    const t = setInterval(() => fetchLiveStreams().then(setLiveStreams), 15000);
    return () => clearInterval(t);
  }, [authLoading]);

  useEffect(() => {
    if (authLoading || !user) return;
    getMatchQueueStatus().then(setMatchInQueue);
  }, [authLoading, user]);

  const handleRandomMatch = async () => {
    if (!user) return;
    setMatchJoining(true);
    const tier = createFormShowTier(matchGame, matchMode) ? (matchTier.trim() || undefined) : undefined;
    const position = matchGame === 'PUBG' ? undefined : (matchPosition ?? undefined);
    const res = await joinMatchQueue(matchGame, tier, position);
    setMatchInQueue(res.inQueue);
    setMatchJoining(false);
  };

  const handleLeaveMatchQueue = async () => {
    await leaveMatchQueue();
    setMatchInQueue(false);
  };

  const handleCreateRoom = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!user) {
      navigate('/login');
      return;
    }
    const trimmedTitle = createTitle.trim();
    if (!trimmedTitle) {
      setCreateError('?úÎ™©???ÖÎ†•??Ï£ºÏÑ∏??');
      return;
    }
    if (!createPassword.trim()) {
      setCreateError('Î∞???†ú??ÎπÑÎ?Î≤àÌò∏Î•??ÖÎ†•??Ï£ºÏÑ∏??');
      return;
    }
    const platformPrefix =
      createGame === 'PUBG' && createPlatform === 'STEAM' ? '[?§Ì?] '
      : createGame === 'PUBG' && createPlatform === 'KAKAO' ? '[Ïπ¥Ïπ¥?? '
      : '';
    const title = (platformPrefix + trimmedTitle).slice(0, 200);
    setCreating(true);
    setCreateError('');
    const gameOptions = JSON.stringify({
      tier: createTier || undefined,
      mode: createRank || createMode || undefined,
      position: createPosition || undefined,
      preferredMap: createPreferredMap.trim() || undefined,
      preferredMethod: createPreferredMethod.trim() || undefined,
      preferredLegend: createPreferredLegend.trim() || undefined,
      platform: createPlatform || undefined,
      partySize: createPartySize || undefined,
    });
    const res = await createGameRoom({
      title,
      memo: createMemo.trim() || undefined,
      deletePassword: createPassword,
      game: createGame,
      gameOptions,
    });
    setCreating(false);
    if (res) {
      setCreateTitle('');
      setCreateMemo('');
      setCreatePassword('');
      setCreatePosition(null);
      setCreateMode('');
      setCreatePreferredMap('');
      setCreatePreferredMethod('');
      setCreatePreferredLegend('');
      setCreatePlatform('');
      setCreatePartySize('');
      fetchRooms();
    } else {
      setCreateError('Î∞?ÎßåÎì§Í∏∞Ïóê ?§Ìå®?àÏäµ?àÎã§.');
    }
  };

  const formatDate = (s: string) => {
    try {
      const d = new Date(s);
      return d.toLocaleDateString('ko-KR', { month: '2-digit', day: '2-digit', hour: 'numeric', minute: '2-digit' });
    } catch {
      return s;
    }
  };

  const tierLabel = (v: string, gameKey?: string) => {
    const opts =
      gameKey === 'PUBG' ? PUBG_TIER_OPTIONS
      : gameKey === 'VALORANT' ? VALORANT_TIER_OPTIONS
      : TIER_OPTIONS;
    return opts.find((o) => o.value === v)?.label ?? '?∞Ïñ¥ ?ÑÏ≤¥';
  };
  const tierOptionsForGame = (gameKey: string) =>
    gameKey === 'PUBG' ? PUBG_TIER_OPTIONS
    : gameKey === 'VALORANT' ? VALORANT_TIER_OPTIONS
    : TIER_OPTIONS;
  const rankLabel = (v: string) => RANK_OPTIONS.find((o) => o.value === v)?.label ?? '?ÑÏ≤¥';
  const modeLabel = (gameKey: string, v: string) => {
    if (!v) return '?ÑÏ≤¥';
    if (gameKey === 'VALORANT') return VALORANT_MODE_OPTIONS.find((o) => o.value === v)?.label ?? v;
    if (gameKey === 'OVERWATCH') return OVERWATCH_MODE_OPTIONS.find((o) => o.value === v)?.label ?? v;
    if (gameKey === 'APEX_LEGENDS') return APEX_MODE_OPTIONS.find((o) => o.value === v)?.label ?? v;
    if (gameKey === 'PUBG') return PUBG_MODE_OPTIONS.find((o) => o.value === v)?.label ?? v;
    return v;
  };
  /** ?¥Îãπ Î™®Îìú?????åÏù¥Î∏??∞Ïñ¥ Ïª¨Îüº??'-' ?úÏãú (?∞Ïñ¥ ?ÜÏùå) */
  const modeHasNoTier = (gameKey: string, mode: string | undefined) => {
    if (!mode) return false;
    if (gameKey === 'LEAGUE_OF_LEGENDS' && (mode === 'QUICK' || mode === 'ARAM')) return true;
    if (gameKey === 'VALORANT' && (mode === 'UNRATED' || mode === 'SPIKE_RUSH')) return true;
    if (gameKey === 'OVERWATCH' && (mode === 'QUICK_PLAY' || mode === 'OPEN_QUEUE')) return true;
    if (gameKey === 'PUBG' && mode === 'NORMAL') return true;
    if (gameKey === 'APEX_LEGENDS' && (mode === 'BATTLE_ROYALE' || mode === 'ARENAS')) return true;
    return false;
  };
  /** Î∞?ÎßåÎì§Í∏??ºÏóê???∞Ïñ¥ ?ÑÎìú ?úÏãú ?¨Î? (Í≤ΩÏüÅ Î™®Îìú???åÎßå ?úÏãú) */
  const createFormShowTier = (game: string, rankOrMode: string) => !modeHasNoTier(game, rankOrMode || undefined);
  /** Î°?ÏπºÎ∞î???òÎùΩ ???¨Ï???ÎØ∏Ìëú??*/
  const showPositionForRoom = (gameKey: string, mode: string | undefined) => {
    if (gameKey === 'LEAGUE_OF_LEGENDS' && mode === 'ARAM') return false;
    return true;
  };
  const extraColumnHeader = (g: string) => {
    if (g === 'PUBG') return '?åÎû´??;
    if (g === 'COUNTER_STRIKE_2') return '?†Ìò∏Î≤?;
    if (g === 'APEX_LEGENDS') return '?†Ìò∏ ?àÏ†Ñ??;
    return 'ÎπÑÍ≥†';
  };
  const extraColumnValue = (op: ReturnType<typeof parseGameOptions>, roomGame: string) => {
    if (roomGame === 'PUBG') return op.platform ? (PUBG_PLATFORM_OPTIONS.find((o) => o.value === op.platform)?.label ?? op.platform) : '-';
    if (roomGame === 'COUNTER_STRIKE_2') return op.preferredMethod || '-';
    if (roomGame === 'APEX_LEGENDS') return op.preferredLegend || '-';
    return '-';
  };
  const partySizeLabel = (value: string | undefined, roomGame: string) => {
    if (!value) return '-';
    const options =
      roomGame === 'PUBG' ? PUBG_PARTY_OPTIONS
      : roomGame === 'APEX_LEGENDS' ? APEX_PARTY_OPTIONS
      : roomGame === 'LEAGUE_OF_LEGENDS' ? LEAGUE_PARTY_OPTIONS
      : roomGame === 'VALORANT' ? VALORANT_PARTY_OPTIONS
      : roomGame === 'COUNTER_STRIKE_2' ? CS2_PARTY_OPTIONS
      : roomGame === 'OVERWATCH' ? OVERWATCH_PARTY_OPTIONS
      : [];
    return options.find((o) => o.value === value)?.label ?? value;
  };
  const displayGame = game === 'ALL' ? 'LEAGUE_OF_LEGENDS' : game;

  let filteredRooms = roomList;
  if (filterTier || filterRank || filterPosition || filterPlatform || filterPreferredMap) {
    filteredRooms = roomList.filter((r) => {
      const op = parseGameOptions(r.gameOptions);
      if (filterTier && op.tier !== filterTier) return false;
      if (filterRank && op.mode !== filterRank) return false;
      if (filterPosition) {
        if (displayGame === 'PUBG') {
          if ((op.partySize ?? '') !== filterPosition) return false;
        } else if (op.position !== filterPosition) return false;
      }
      if (filterPlatform && op.platform !== filterPlatform) return false;
      if (filterPreferredMap && r.game === 'PUBG') {
        const map = (op.preferredMap ?? '').trim().toLowerCase();
        const q = filterPreferredMap.trim().toLowerCase();
        if (q && !map.includes(q)) return false;
      }
      return true;
    });
  }

  const onGameTabClick = (tabKey: string) => {
    setGame(tabKey);
    if (tabKey !== 'ALL') setCreateGame(tabKey);
  };

  const gameTabsSection = (
    <div className="game-tabs main-game-tabs" id="matching">
      {GAME_TABS.map((tab) => (
        <button
          key={tab.key}
          type="button"
          className={game === tab.key ? 'active' : ''}
          onClick={() => onGameTabClick(tab.key)}
        >
          {tab.label}
        </button>
      ))}
    </div>
  );

  /** ?úÎç§ Îß§Ïπ≠ ?®ÎÑê (?¨Ïù¥?úÎ∞î¬∑?∏Îùº??Í≥µÏö©) */
  const randomPanelContent = (
    <div className="sidebar-panel random-panel">
      <h3 className="sidebar-panel-title">?úÎç§ Îß§Ïπ≠</h3>
      {user ? (
        matchInQueue ? (
          <>
            <p className="sidebar-panel-desc">Îß§Ïπ≠ Ï§ë‚Ä?/p>
            <button type="button" className="sidebar-btn secondary" onClick={handleLeaveMatchQueue}>Ï∑®ÏÜå</button>
          </>
        ) : (
          <>
            <p className="sidebar-panel-desc">Í∞ôÏ? Ï°∞Í±¥???†Ï??Ä Îß§Ïπ≠?©Îãà??</p>
            <div className="random-match-form">
              <label className="sidebar-form-label">Í≤åÏûÑ</label>
              <select className="sidebar-form-input" value={matchGame} onChange={(e) => { setMatchGame(e.target.value); setMatchMode(''); setMatchPartySize(''); }}>
                {GAME_OPTIONS.map((o) => (
                  <option key={o.key} value={o.key}>{o.label}</option>
                ))}
              </select>
              {getMatchModeOptions(matchGame).length > 0 && (
                <>
                  <label className="sidebar-form-label">Î™®Îìú</label>
                  <select className="sidebar-form-input" value={matchMode} onChange={(e) => setMatchMode(e.target.value)}>
                    {getMatchModeOptions(matchGame).map((o) => (
                      <option key={o.value || '_'} value={o.value}>{o.label}</option>
                    ))}
                  </select>
                </>
              )}
              {createFormShowTier(matchGame, matchMode) && (
                <>
                  <label className="sidebar-form-label">?∞Ïñ¥</label>
                  <select className="sidebar-form-input" value={matchTier} onChange={(e) => setMatchTier(e.target.value)}>
                    {tierOptionsForGame(matchGame).map((o) => (
                      <option key={o.value || '_'} value={o.value}>{o.label}</option>
                    ))}
                  </select>
                </>
              )}
              {getMatchPartyOptions(matchGame).length > 0 && (
                <>
                  <label className="sidebar-form-label">?∏Ïõê</label>
                  <select className="sidebar-form-input" value={matchPartySize} onChange={(e) => setMatchPartySize(e.target.value)}>
                    {getMatchPartyOptions(matchGame).map((o) => (
                      <option key={o.value || '_'} value={o.value}>{o.label}</option>
                    ))}
                  </select>
                </>
              )}
              {matchGame !== 'PUBG' && !(matchGame === 'LEAGUE_OF_LEGENDS' && matchMode === 'ARAM') && (
                <>
                  <label className="sidebar-form-label">?¨Ï???/label>
                  <PositionPicker value={matchPosition} onChange={setMatchPosition} game={matchGame} filterMode className="random-match-position" />
                </>
              )}
              <button type="button" className="sidebar-btn primary" onClick={handleRandomMatch} disabled={matchJoining} style={{ marginTop: 16 }}>
                {matchJoining ? 'Ï∞∏Í? Ï§ë‚Ä? : 'Îß§Ïπ≠ ?úÏûë'}
              </button>
            </div>
          </>
        )
      ) : (
        <Link to="/login" className="sidebar-btn primary">Î°úÍ∑∏????Îß§Ïπ≠</Link>
      )}
    </div>
  );

  /** ?úÎç§ Îß§Ïπ≠ ?¥Ïó≠ ?®ÎÑê (?¨Ïù¥?úÎ∞î¬∑?∏Îùº??Í≥µÏö©) - 2Î≤àÏß∏ ?¨ÏßÑÏ≤òÎüº Î¶¨Ïä§??+ ??†ú */
  const historyPanelContent = (
    <div className="sidebar-panel history-panel">
      <h3 className="sidebar-panel-title">?úÎç§ Îß§Ïπ≠ ?¥Ïó≠</h3>
      <p className="sidebar-panel-desc">Îß§Ïπ≠???Ä Ï±ÑÌåÖÎß??§Ïãú Î≥????àÏäµ?àÎã§.</p>
      {!user ? (
        <Link to="/login" className="sidebar-btn primary">Î°úÍ∑∏????Î≥¥Í∏∞</Link>
      ) : matchHistoryLoading ? (
        <div className="duo-empty">Î°úÎî© Ï§ë‚Ä?/div>
      ) : matchHistoryList.length === 0 ? (
        <div className="duo-empty">?ÑÏßÅ Îß§Ïπ≠ ?¥Ïó≠???ÜÏäµ?àÎã§.</div>
      ) : (
        <ul className="match-history-list match-history-list-inline">
          {matchHistoryList.map((s) => (
            <li key={s.id} className="match-history-item">
              <Link to={`/match-chat/${s.id}`} className="match-history-link" onClick={() => setShowMatchingSidebar(false)}>
                <div className="match-history-avatar">
                  <span className="match-history-avatar-initial">{(MATCH_HISTORY_GAME_LABELS[s.game] ?? s.game)[0]}</span>
                </div>
                <div className="match-history-content">
                  <span className="match-history-name">{MATCH_HISTORY_GAME_LABELS[s.game] ?? s.game}</span>
                  <span className="match-history-preview">Ï±ÑÌåÖ Î≥¥Í∏∞</span>
                </div>
                <span className="match-history-time">{formatHistoryTime(s.createdAt)}</span>
              </Link>
              <button
                type="button"
                className="match-history-delete-btn"
                onClick={(e) => { e.preventDefault(); handleDeleteMatchHistory(s.id); }}
                disabled={matchHistoryDeletingId === s.id}
                title="?¥Ïó≠ ??†ú"
                aria-label="?¥Ïó≠ ??†ú"
              >
                {matchHistoryDeletingId === s.id ? '??†ú Ï§ë‚Ä? : '??†ú'}
              </button>
            </li>
          ))}
        </ul>
      )}
    </div>
  );

  /** Î∞?ÎßåÎì§Í∏??®ÎÑê (?¨Ïù¥?úÎ∞î¬∑?∏Îùº??Í≥µÏö©) */
  const createPanelContent = (
    <div className="sidebar-panel create-panel" role="region" aria-labelledby="create-room-heading">
      <h3 id="create-room-heading" className="sidebar-panel-title">Î∞?ÎßåÎì§Í∏?/h3>
      <form
              id="team-search-form"
              className="team-search-form"
              role="search"
              aria-label="∆¿ ∞Àªˆ ¡∂∞«"
              onSubmit={(e) => e.preventDefault()}
            >
              <fieldset className="team-search-fieldset">
                <legend className="team-search-legend">∆¿ ∞Àªˆ ¡∂∞«</legend>
                <div className="team-search-filters">
                  <PositionPicker value={filterPosition} onChange={setFilterPosition} game={displayGame} filterMode className="team-search-position-filter" />
                  <select
                    className="team-search-select"
                    value={filterTier}
                    onChange={(e) => setFilterTier(e.target.value)}
                    aria-label="∆ºæÓ"
                    name="tier"
                  >
                    {tierOptionsForGame(game === 'ALL' ? 'LEAGUE_OF_LEGENDS' : game).map((o) => (
                      <option key={o.value || '_'} value={o.value}>{o.label}</option>
                    ))}
                  </select>
                  <select
                    className="team-search-select"
                    value={filterRank}
                    onChange={(e) => setFilterRank(e.target.value)}
                    aria-label="∑©≈©/∏µÂ"
                    name="rank"
                  >
                    {getSearchModeOptions(displayGame).map((o) => (
                      <option key={o.value || '_'} value={o.value}>{o.label}</option>
                    ))}
                  </select>
                  {game === 'PUBG' && (
                    <>
                      <select
                        className="team-search-select"
                        value={filterPlatform}
                        onChange={(e) => setFilterPlatform(e.target.value)}
                        aria-label="«√∑ß∆˚"
                        name="platform"
                      >
                        {PUBG_PLATFORM_OPTIONS.map((o) => (
                          <option key={o.value || '_'} value={o.value}>{o.label}</option>
                        ))}
                      </select>
                      <input
                        type="text"
                        className="team-search-select team-search-input"
                        value={filterPreferredMap}
                        onChange={(e) => setFilterPreferredMap(e.target.value)}
                        placeholder="º±»£ ∏ "
                        aria-label="º±»£ ∏ "
                        maxLength={100}
                      />
                    </>
                  )}
                </div>
                <div className="team-search-actions">
                  <button type="button" className="btn-primary team-search-btn" onClick={() => fetchRooms()}>¡∂»∏</button>
                </div>
              </fieldset>
            </form>
            <div className="team-search-table-wrap">
            <table className="team-search-table">
              <thead>
                <tr>
                  <th>?úÎ™©</th>
                  <th>?∞Ïñ¥</th>
                  <th>??Å¨</th>
                  {displayGame !== 'PUBG' && <th>?¨Ï???/th>}
                  <th>{extraColumnHeader(displayGame)}</th>
                  {displayGame === 'PUBG' && <th>?†Ìò∏ Îß?/th>}
                  <th>?∏Ïõê</th>
                  <th>Î∞©Ïû•</th>
                  <th>?±Î°ù??/th>
                  <th>Ï∞∏Í?</th>
                </tr>
              </thead>
              <tbody>
                {loadingRooms ? (
                  <tr><td colSpan={displayGame === 'PUBG' ? 11 : 10} className="team-search-empty">Î°úÎî© Ï§ë‚Ä?/td></tr>
                ) : filteredRooms.length === 0 ? (
                  <tr><td colSpan={displayGame === 'PUBG' ? 11 : 10} className="team-search-empty">?±Î°ù??Î∞©Ïù¥ ?ÜÏäµ?àÎã§. ?∞Ï∏°?êÏÑú Î∞©ÏùÑ ÎßåÎì§??Î≥¥ÏÑ∏??</td></tr>
                ) : (
                  filteredRooms.map((r) => {
                    const op = parseGameOptions(r.gameOptions);
                    return (
                      <tr key={r.id}>
                        <td>{r.title}</td>
                        <td>{modeHasNoTier(r.game, op.mode) ? '-' : tierLabel(op.tier ?? '', r.game)}</td>
                        <td>{r.game === 'LEAGUE_OF_LEGENDS' ? rankLabel(op.mode ?? '') : (['VALORANT', 'OVERWATCH', 'APEX_LEGENDS', 'PUBG'].includes(r.game) ? modeLabel(r.game, op.mode ?? '') : op.mode || '-')}</td>
                        {displayGame !== 'PUBG' && <td>{showPositionForRoom(r.game, op.mode) ? <PositionIcon position={op.position} game={r.game} showLabel /> : '-'}</td>}
                        <td>{extraColumnValue(op, r.game)}</td>
                        {displayGame === 'PUBG' && <td>{op.preferredMap ?? '-'}</td>}
                        <td>{partySizeLabel(op.partySize, r.game)}</td>
                        <td>{r.hostNickname ?? '-'}</td>
                        <td>{formatDate(r.createdAt)}</td>
                        <td>
                          {r.isMember ? (
                            <span className="team-search-joined-label">Ï∞∏Í? Ï§?/span>
                          ) : r.closed ? (
                            <span className="team-search-closed-label">ÎßàÍ∞ê</span>
                          ) : (
                            <button
                              type="button"
                              className="btn-primary team-search-join-btn"
                              onClick={() => handleJoinRoom(r.id)}
                              disabled={joinRoomId === r.id || !user}
                            >
                              {joinRoomId === r.id ? 'Ï∞∏Í? Ï§ë‚Ä? : 'Ï∞∏Í?'}
                            </button>
                          )}
                        </td>
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
          </div>
          </div>
        </section>

        {showMatchingSidebar && (
        <aside className="main-sidebar section-card sidebar-card matching-sidebar-panel">
          <div className="sidebar-tabs">
            <button type="button" className={sidebarTab === 'random' ? 'active' : ''} onClick={() => setSidebarTab('random')}>?úÎç§ Îß§Ïπ≠</button>
            <button type="button" className={sidebarTab === 'history' ? 'active' : ''} onClick={() => setSidebarTab('history')}>?úÎç§ Îß§Ïπ≠ ?¥Ïó≠</button>
            <button type="button" className={sidebarTab === 'create' ? 'active' : ''} onClick={() => setSidebarTab('create')}>Î∞?ÎßåÎì§Í∏?/button>
          </div>
          <div className="sidebar-content">
            {sidebarTab === 'random' && randomPanelContent}
            {sidebarTab === 'history' && historyPanelContent}
            {sidebarTab === 'create' && createPanelContent}
          </div>
        </aside>
        )}
      </div>
    </Layout>
  );
}
