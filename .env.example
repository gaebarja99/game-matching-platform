# =============================================================
# GameMatcher 환경변수 템플릿
# 실제 값을 채운 뒤 .env 로 복사하거나, 서버/CI의 환경변수로 등록하세요.
# 이 파일(.env.example) 자체는 실제 값이 없으므로 git에 커밋해도 안전합니다.
# .env, application.properties, application-oauth.properties, secrets/ 는 절대 커밋하지 마세요.
# =============================================================

# ----- Database (RDS / MariaDB) -----
DB_URL=jdbc:mariadb://<host>:3306/<db_name>?useSSL=true&trustServerCertificate=true
DB_USERNAME=
DB_PASSWORD=

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Kakao OAuth -----
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ----- Naver OAuth -----
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ----- Discord -----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ----- Blizzard -----
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_OAUTH_CLIENT_ID=
BLIZZARD_OAUTH_CLIENT_SECRET=

# ----- Game APIs -----
RIOT_API_KEY=
VALORANT_API_KEY=
PUBG_API_KEY=
STEAM_API_KEY=
TRACKER_API_KEY=

# ----- Admin -----
ADMIN_API_KEY=
ADMIN_SEED_LOGIN_ID=admin
ADMIN_SEED_PASSWORD=
ADMIN_SEED_USERNAME=관리자
ADMIN_SEED_EMAIL=admin@gamematcher.local

# ----- OpenAI (LLM 평가) -----
OPENAI_API_KEY=
OPENAI_API_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# ----- Frontend / Backend base URL -----
APP_FRONTEND_PUBLIC_URL=https://your-domain.example
APP_FRONTEND_BASE_URL=https://your-domain.example
APP_BACKEND_BASE_URL=https://your-domain.example

# ----- Firebase (push / admin SDK) -----
# 서비스 계정 JSON 파일 경로 (파일 자체는 git에 커밋하지 말 것)
FIREBASE_SERVICE_ACCOUNT_PATH=/secure/path/firebase-service-account.json

# ----- PortOne / SMS 등 -----
# application-portone-local.properties, application-sms-local.properties 참고 (gitignore 처리됨)
