# 이 파일을 application-oauth-local.properties 로 복사해 두면 Git 에 올라가지 않습니다 (.gitignore).
#
# --- Google: invalid_token_response / 401 Unauthorized ---
# Google Cloud → 사용자 인증 정보 → OAuth 클라이언트(웹 애플리케이션)에서 "클라이언트 보안 비밀" 재발급 후:
# spring.security.oauth2.client.registration.google.client-id=....apps.googleusercontent.com
# spring.security.oauth2.client.registration.google.client-secret=GOCSPX_...
# 리다이렉트 URI는 콘솔에 http://localhost:8080/login/oauth2/code/google (및 사용 시 127.0.0.1 동일 경로) 등록
#
# --- Kakao ---
# spring.security.oauth2.client.registration.kakao.client-id=...
# spring.security.oauth2.client.registration.kakao.client-secret=...
#
# --- Naver ---
# spring.security.oauth2.client.registration.naver.client-id=...
# spring.security.oauth2.client.registration.naver.client-secret=...
